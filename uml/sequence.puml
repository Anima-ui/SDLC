@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 12
autonumber
title Диаграмма последовательности «Получение рекомендаций» (UC-04)

actor Пользователь as User
participant "RecommendationController" as Controller
participant "RecommendationService" as Service
participant "CollectionRepository" as CollectionRepo
participant "MovieRepository" as MovieRepo
database "PostgreSQL" as DB

User -> Controller : GET /api/recommendations
activate Controller
Controller -> Service : getRecommendations(currentUserId)
activate Service

Service -> CollectionRepo : findByUserId(currentUserId)
activate CollectionRepo
CollectionRepo -> DB : запрос статусов и оценок пользователя
activate DB
DB --> CollectionRepo : личные записи
deactivate DB
CollectionRepo --> Service : статусы и оценки
deactivate CollectionRepo

Service -> MovieRepo : findAllActive()
activate MovieRepo
MovieRepo -> DB : запрос активных карточек и жанров
activate DB
DB --> MovieRepo : фильмы и жанры
deactivate DB
MovieRepo --> Service : кандидаты
deactivate MovieRepo

Service -> Service : исключить просмотренные и брошенные

alt у пользователя не менее трёх оценок
  Service -> Service : вычислить веса жанров\nи ранжировать кандидатов
else холодный старт
  Service -> Service : сформировать общий список\nв стабильном порядке
end

Service -> Service : выбрать до 10 фильмов\nи сформировать объяснения
Service --> Controller : RecommendationDto[]
deactivate Service
Controller --> User : HTTP 200, рекомендации с причинами
deactivate Controller
@enduml
