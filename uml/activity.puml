@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
title Диаграмма активности «Импорт коллекции из CSV» (UC-05)

start
:Пользователь выбирает CSV-файл;
:Система проверяет сеанс, формат и заголовки;

if (Файл имеет допустимый формат?) then (да)
  :Проверить значения строк;
  :Сопоставить фильмы с локальным каталогом;
  :Разделить строки на новые,\nсуществующие и ошибочные;
  :Показать предварительный результат\nбез изменения коллекции;

  if (Пользователь подтверждает импорт?) then (да)
    :Повторно проверить файл\nи текущее состояние коллекции;
    :Исключить ошибки, неоднозначности и дубли;
    :Начать транзакцию;
    :Добавить допустимые новые записи;

    if (Сохранение выполнено успешно?) then (да)
      :Зафиксировать транзакцию;
      :Показать добавленные и пропущенные строки;
    else (нет)
      :Откатить транзакцию;
      :Показать ошибку сохранения;
    endif
  else (нет)
    :Завершить без изменения коллекции;
  endif
else (нет)
  :Показать ошибку формата;
endif

stop
@enduml
